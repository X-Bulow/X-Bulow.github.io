---
import { profileLinks, site } from '../config';
import EmailLink from './EmailLink.astro';
import Icon from './Icon.astro';
import Ornament from './Ornament.astro';

const initials = site.name
  .split(/\s+/)
  .map((word) => word[0])
  .join('');
---

<section class="profile">
  <div class="portrait">
    {
      site.photo ? (
        <img src={site.photo} alt={`Photo of ${site.name}`} width="192" height="240" />
      ) : (
        <div class="monogram" aria-hidden="true">
          {initials}
        </div>
      )
    }
  </div>
  <h1 class="name">{site.name}</h1>
  <p class="position">
    {site.position.map((line) => <span>{line}</span>)}
  </p>
  <p class="location"><Icon name="pin" />{site.location}</p>
  <ul class="profile-links">
    <li><EmailLink /></li>
    {
      profileLinks.map((link) => (
        <li>
          <a href={link.url}>
            <Icon name={link.icon} />
            {link.label}
          </a>
        </li>
      ))
    }
    <li><a href="/cv/"><Icon name="cv" />CV</a></li>
  </ul>
  <Ornament name="waves" class="profile-waves" />
</section>

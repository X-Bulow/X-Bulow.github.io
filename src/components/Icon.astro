---
import { siBluesky, siDblp, siGithub, siGooglescholar, siOrcid, siSemanticscholar, siX } from 'simple-icons';
import type { IconName } from '../config';

type Name = IconName | 'sun' | 'moon' | 'pin' | 'arrow' | 'cube';

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className } = Astro.props;

// Brand logos (filled), from Simple Icons.
const brands: Partial<Record<Name, string>> = {
  github: siGithub.path,
  scholar: siGooglescholar.path,
  semanticscholar: siSemanticscholar.path,
  dblp: siDblp.path,
  orcid: siOrcid.path,
  x: siX.path,
  bluesky: siBluesky.path,
};

// Line icons (stroked).
const lines: Partial<Record<Name, string>> = {
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  cv: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.25v.01M12 17v-6.5M12 13.5a2.5 2.5 0 0 1 5 0V17"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  moon: '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  cube: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5M12 12 4 7.5M12 12v9"/>',
};

const brand = brands[name];
---

{
  brand ? (
    <svg class:list={['icon', className]} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={brand} />
    </svg>
  ) : (
    <svg
      class:list={['icon', className]}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={lines[name] ?? lines.link}
    />
  )
}

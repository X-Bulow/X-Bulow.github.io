---
// Decorative line art in the Rusty Lake spirit: the cube, lake ripples and a crow.
// Everything draws in currentColor and gets a slight hand-drawn wobble from the
// #sketch filter defined in the Base layout.

interface Props {
  name: 'cube' | 'waves' | 'crow';
  class?: string;
}

const { name, class: className } = Astro.props;
---

{
  name === 'cube' && (
    <svg class:list={['ornament', 'ornament-cube', className]} viewBox="0 0 64 64" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round">
        <path d="M32 6 54 19v26L32 58 10 45V19z" fill="currentColor" fill-opacity=".08" />
        <path d="M32 6v26M32 32 10 19M32 32l22-13M32 32v26" />
        <path d="M32 6 54 19 32 32 10 19z" fill="currentColor" fill-opacity=".18" />
      </g>
    </svg>
  )
}

{
  name === 'waves' && (
    <svg class:list={['ornament', 'ornament-waves', className]} viewBox="0 0 160 24" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path d="M4 8c10-8 20-8 30 0s20 8 30 0 20-8 30 0 20 8 30 0 20-8 30 0" />
        <path d="M24 17c8-6 16-6 24 0s16 6 24 0 16-6 24 0 16 6 24 0" opacity=".55" />
      </g>
    </svg>
  )
}

{
  name === 'crow' && (
    <svg class:list={['ornament', 'ornament-crow', className]} viewBox="0 0 120 72" aria-hidden="true">
      <path
        class="crow-body"
        d="M3 28 20 20c4-10 16-12 22-6l2 4c10-2 24 2 36 12l38 22 2 4-28-4c-8 6-22 8-36 6-12-1-26-8-32-20l-6-7z"
      />
      <path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M50 58v11m-7 2 7-2 7 2M62 58v11m-7 2 7-2 7 2" />
    </svg>
  )
}

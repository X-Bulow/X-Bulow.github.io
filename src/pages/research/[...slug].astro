---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getProjects, hasPage, type Project } from '../../lib/collections';
import { inline } from '../../lib/markdown';

export async function getStaticPaths() {
  const projects = (await getProjects()).filter(hasPage);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const meta = [data.role, data.affiliation, data.period].filter((part): part is string => Boolean(part));
---

<Base title={data.title} description={data.summary}>
  <article>
    <a class="back" href="/research/">← Research</a>
    <header class="page-header">
      <h1>
        {data.title}
        {data.status === 'ongoing' && <span class="badge badge-ongoing">Ongoing</span>}
      </h1>
      {meta.length > 0 && <p class="card-meta" set:html={meta.map(inline).join(' · ')} />}
      {
        data.advisors.length > 0 && (
          <p class="card-meta">
            {data.advisors.length > 1 ? 'Advisors' : 'Advisor'}:{' '}
            <span set:html={data.advisors.map(inline).join(', ')} />
          </p>
        )
      }
      {
        data.tags.length > 0 && (
          <ul class="tags">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      {
        data.links.length > 0 && (
          <div class="pub-links">
            {data.links.map((link) => (
              <a class="chip" href={link.url}>
                {link.label} <Icon name="arrow" />
              </a>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getMiscPages, type MiscPage } from '../../lib/collections';

export async function getStaticPaths() {
  const pages = await getMiscPages();
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

interface Props {
  page: MiscPage;
}

const { page } = Astro.props;
const { data } = page;
const { Content } = await render(page);
---

<Base title={data.title} description={data.description}>
  <article>
    <a class="back" href="/misc/">← Misc</a>
    <header class="page-header">
      <h1>
        {data.title}
        {data.draft && <span class="badge badge-preprint">Draft</span>}
      </h1>
      {data.description && <p class="lede">{data.description}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

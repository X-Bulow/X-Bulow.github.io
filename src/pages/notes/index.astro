---
import Base from '../../layouts/Base.astro';
import { getNotes } from '../../lib/collections';
import { formatDate } from '../../lib/format';

const notes = await getNotes();
---

<Base title="Notes" description="Notes and writing by Zefeng Cheng.">
  <header class="page-header">
    <h1>Notes</h1>
    <p class="lede">Technical notes, paper readings and research write-ups.</p>
  </header>

  {
    notes.length > 0 ? (
      <ul class="note-list">
        {notes.map((note) => (
          <li>
            <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
            <div>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
              {note.data.draft && <span class="badge badge-preprint">Draft</span>}
              {note.data.description && <p>{note.data.description}</p>}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">Nothing here yet.</p>
    )
  }
</Base>
